@using Console_Care.ViewModel
@model RoleViewModel

@{
    ViewData["Title"] = "AddRole";
}

@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>AddCash</h1>
<div class="mycontainer" style="margin-left:0px;">
    <div class=" Deleteform " style="width:100%">

        <section class="">
            <h2 class="title" style="color:white;">AddEmployee</h2>
            <form asp-action="AddRole" style="justify-items: center;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="NameRole" class="control-label"></label>
                    <input asp-for="NameRole" class="form-control" />
                    <span asp-validation-for="NameRole" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </section>
    </div>
</div>
