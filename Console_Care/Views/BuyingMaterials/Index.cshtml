@model IEnumerable<Console_Care.Models.BuyingMaterials>

@{
    ViewData["Title"] = "Index";
}




@{

    var list1 = new HashSet<string>();
    foreach (var item in Model)
    {
        list1.Add(item.NameOfBuyer);

    }
    var list2 = new HashSet<string>();
    foreach (var item in Model)
    {
        list2.Add(item.NameOfMaterials);

    }
    var list3 = new HashSet<DateTime>();
    foreach (var item in Model)
    {
        list3.Add(item.DateTime);

    }

}
@section css {
    <link href="~/css/admin.css" rel="stylesheet" />

    <script src="~/moment.js/moment.min.js"></script>
    <script src="~/bootstrap-daterangepicker/daterangepicker.min.js"></script>
}

<partial>
    @Html.Partial("BankingDashBoard");
</partial>

<div class="mainorder">
    <div class="topbar">
        <div class="search">
            <label class="bar">
                <input type="text" id="searchinput" placeholder="Search Here..." onkeyup="search()" />
                <ion-icon name="search-outline"></ion-icon>
            </label>
        </div>
    </div>
    <div class="filter">
        <div class="filterlist">
            <label>Name</label>
            <select class="form-control" id="filtername" onchange="filter2()">
                <option value="0">--select--</option>
                @foreach (var item in list1)
                {
                    <option>@item</option>
                }
            </select>

        </div>
        <div class="filterlist">
            <label>material</label>
            <select class="form-control" id="filterps" onchange="filter2()">
                <option value="0">--select--</option>
                @foreach (var item in list2)
                {
                    <option>@item</option>
                }
            </select>

        </div>
        <div class="filterlist">
            <label>date</label>
            <input type="date" class="form-control" id="filterCity" onchange="filter2()" />

        </div>


    </div>
    <div class="allorders uppertabemp">
        <div>
            <h2>مشتريات الموارد</h2>
        </div>
        <div>
            <a id="dl-csvorder" class="btn btn-secondary ">Download As Excel</a>
        </div>
        <div>
            <a asp-action="Create" class="btn btn-success ">Add</a>
        </div>
    </div>
    <section class="details">
        <div class="allorders">
            <div class="cardheader">
                <table class="table scroll" id="tblorder">
                    <thead>
                        <tr>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.NameOfMaterials)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.NameOfBuyer)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.DateTime)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.PriceofPiece)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.NoPiece)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.TotalPrice)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.Note)</th>
                            <th class="tblcoltext"></th>
                        </tr>
                    </thead>
                    <tbody class="mytable">
                        @foreach (var item in Model)
                        {
                            <tr class="order namesearch">
                                <td>@item.NameOfMaterials </td>
                                <td>@item.NameOfBuyer </td>
                                <td>@item.DateTime.ToString("yyyy-MM-dd hh:mm:ss tt")</td>
                                <td>@item.PriceofPiece</td>
                                <td>@item.NoPiece</td>
                                <td>@item.TotalPrice</td>
                                <td>@item.Note</td>
                                <td>
                                    <a asp-route-id="@item.id" class="btn btn-secondary" asp-action="Edit">Edit</a> |
                                    <a asp-route-id="@item.id" class="btn btn-danger " asp-action="Delete">Delete</a> |
                                </td>

                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>

    </section>
</div>
@section Scripts {


}