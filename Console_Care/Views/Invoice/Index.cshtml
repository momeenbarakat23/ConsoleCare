@model IEnumerable<Console_Care.Models.CustomerDataBasesInvoice>

@{
    ViewData["Title"] = "Index";
    var counter = 0;
}

@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>getdata</h1>
<div class="mycontainer" style="margin-left:0px;">

    <div class=" Deleteform " style="width:100%">

        <section class="">
            <h2 class="title" style="color:white;">@ViewBag.name</h2>
           <div class="pricecard">
                <div class="card text-white bg-primary mb-3" style="max-width: 18rem;">
                    <div class="card-header">إجمالى الفاتورة</div>
                    <div class="card-body">
                        <p class="card-header"><input id="invoice-total" type="number" value="@TempData["total"]" style="width: 100%; text-align: center; border: none; background-color: transparent; color: white;" />EGP</p>
                    </div>
                </div>
                <div class="card text-white bg-success mb-3" style="max-width: 18rem;">
                    <div class="card-header">المدفوع</div>
                    <div class="card-body">
                        <p class="card-header"><input id="invoice-total" type="number" value="@TempData["paid"]" style="width: 100%; text-align: center; border: none; background-color: transparent; color: white;" />EGP</p>
                    </div>
                </div>
                <div class="card text-white bg-danger mb-3" style="max-width: 18rem;">
                    <div class="card-header">الباقي</div>
                    <div class="card-body">
                        <p class="card-header"><input id="invoice-total" type="number" value="@TempData["remaining"]" style="width: 100%; text-align: center; border: none; background-color: transparent; color: white;" />EGP</p>
                    </div>
                </div>
           </div>
            <a asp-action="Add" asp-controller="Invoice" class="btn btn-success"><h3>اضافه فاتوره</h3></a>
            <div class="mycontent">
                @foreach (var item in Model)
                {
                    @if(true){ counter =counter+1;}

                    
                        <div class="mycard">
                            <div class="icon">
                                <img  />
                            </div>
                            <div class="info">
                                <h3>الفاتوره @counter </h3>
                                <div style="display:flex; justify-content:space-between;">
                                <a asp-action="Display" asp-controller="Invoice" asp-route-invoiceid="@item.Invoicesid" asp-route-custid="@item.CustomerDataBasesid" class="btn btn-success" style="width:100px;" >عرض </a>
                                <a asp-action="Edit" asp-controller="Invoice" asp-route-invoiceid="@item.Invoicesid" asp-route-custid="@item.CustomerDataBasesid" class="btn btn-secondary" style="width:100px;">تعديل </a>
                                <a asp-action="Delete" asp-controller="Invoice" asp-route-invoiceid="@item.Invoicesid" asp-route-custid="@item.CustomerDataBasesid" class="btn btn-danger"style="width:100px;">حذف </a>
                                </div>
                            </div>
                        </div>
                    
                }
                
            </div>

        </section>
    </div>
</div>



