@model Console_Care.Models.StaticAssets

@{
    ViewData["Title"] = "Edit";
}

@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>الأصول الثابتة</h1>
<div class="mycontainer" style="margin-left:0px;">
    <div class=" Deleteform " style="width:100%">

        <section class="">
            <h2 class="title" style="color:white;">اضافه الأصول الثابتة</h2>
            <form asp-action="Edit" style="justify-items: center;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Statement" class="control-label"></label>
                    <input asp-for="Statement" class="form-control" />
                    <span asp-validation-for="Statement" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Price" class="control-label"></label>
                    <input asp-for="Price" class="form-control" />
                    <span asp-validation-for="Price" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Number" class="control-label"></label>
                    <input asp-for="Number" class="form-control" />
                    <span asp-validation-for="Number" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="typeOfStaticAssets" class="control-label"></label>
                    <select class="form-control" asp-for="typeOfStaticAssets" id="typeofcust">
                        <option value="0" selected>select</option>
                        <option value="العدةوالأدوات">العدةوالأدوات</option>
                        <option value="الأثاث-الأجهزة">الأثاث-الأجهزة</option>
                    </select>
                    <span asp-validation-for="typeOfStaticAssets" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="typeofcash" class="control-label"></label>
                    <select class="form-control" asp-for="typeofcash" id="typeofcust">
                        <option>@Model.typeofcash</option>
                        <option value="VodafoneCash">VodafoneCash</option>
                        <option value="عهده">عهده</option>
                        <option value="Instapay">Instapay</option>
                        <option value="الخزنه">الخزنه</option>
                    </select>
                    <span asp-validation-for="typeofcash" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Specifications" class="control-label"></label>
                    <input asp-for="Specifications" class="form-control" />
                    <span asp-validation-for="Specifications" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DateTime" class="control-label"></label>
                    <input asp-for="DateTime" class="form-control" />
                    <span asp-validation-for="DateTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Note" class="control-label"></label>
                    <input asp-for="Note" class="form-control" />
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </section>
    </div>
</div>
