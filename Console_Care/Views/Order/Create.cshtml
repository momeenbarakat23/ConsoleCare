@model Console_Care.ViewModel.OrderByCustomer

@{
    var data = User.Claims;
    
}
@section css{
    <link href="~/css/order.css" rel="stylesheet" /> 
    <style>
        
       
</style>
}

<h1>Create</h1>

<h4>OrderByCustomer</h4>
<hr />
<div class="orderform">
    <div class="col-md-4">
        <form asp-action="Create">
            <div id="error" asp-validation-summary="ModelOnly" class="text-danger"></div>
            <div class="form-group">
                <label asp-for="Name" class="control-label"></label>
                @if (User.Identity.IsAuthenticated)
                {
                    <input  class="form-control input-field" type="text" name="name" value="@ViewBag.name" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                }else{
                    <input  asp-for="Name" class="form-control input-field" required />
                    <span asp-validation-for="Name" class="text-danger"></span>
                }
            </div>
            <div class="form-group">
                <label asp-for="Phone" class="control-label"></label>
                @if (User.Identity.IsAuthenticated && (ViewBag.phone != null))
                {
                    <input class="form-control input-field" type="text" name="Phone" value="@ViewBag.phone" required />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                }
                else
                {
                    <input asp-for="Phone" class="form-control input-field" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                }
                
                
            </div>
            <div class="form-group">
                <label asp-for="TypeOfCustomer" class="control-label"></label>
                <select asp-for="TypeOfCustomer" class="form-control input-field">
                    <option value="Home">--select--</option>
                    <option>Home</option>
                    <option>Hall Effect</option>
                    <option>PsCafe</option>
                </select>
                <span asp-validation-for="TypeOfCustomer" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ps4OrPs5" class="control-label"></label>
                <select asp-for="Ps4OrPs5" class="form-control input-field">
                    <option value="ps4">select</option>
                    <option>ps4</option>
                    <option>ps5</option>
                    <option>xbox series</option>
                </select>
                <span asp-validation-for="Ps4OrPs5" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Address" class="control-label"></label>
                @if (User.Identity.IsAuthenticated)
                {
                    <input id="Address" class="form-control input-field" type="text" name="Address" value="@ViewBag.addrees" required />
                    <span asp-validation-for="Address" class="text-danger"></span>
                }
                else
                {
                    <input id="Address" asp-for="Address" class="form-control input-field" />
                    <span asp-validation-for="Address" class="text-danger"></span>
                }
               
            </div>
            <div class="form-group">
                <label asp-for="city" class="control-label"></label>
                @if (User.Identity.IsAuthenticated)
                {
                    <input id="city" class="form-control input-field" type="text" name="city" value="@ViewBag.city" required />
                    <span  asp-validation-for="city" class="text-danger"></span>
                }
                else
                {
                    <input id="city" asp-for="city" class="form-control input-field" />
                    <span asp-validation-for="city" class="text-danger"></span>
                }

            </div>
            <div class="form-group">
                <label asp-for="Order" class="control-label"></label>
                <input id="Order" asp-for="Order" class="form-control input-field" />
                <span asp-validation-for="Order" class="text-danger"></span>
            </div>
            <div class="btn btn-success">
                <input type="submit"  value="Create" class=" btn-success form-control" />
            </div>
            <div class="btn btn-dark">
                <a asp-action="Index" asp-controller="Home" class=" btn-dark form-control">Back to Home</a>
            </div>
        </form>
    </div>
</div>



@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
}
