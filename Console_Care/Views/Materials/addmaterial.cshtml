@model Console_Care.Models.Materials

@{
    ViewData["Title"] = "Create";
}

@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>Create</h1>
<div class="mycontainer" style="margin-left:0px;">

    <div class=" Deleteform " style="width:100%">

        <section class="">
            <h2 class="title" style="color:white;">اضافه موارد</h2>
            <form asp-action="addmaterial" method="post" style="justify-items: center;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Name" class="control-label"></label>
                    <input asp-for="Name" class="form-control" />
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Storage" class="control-label"></label>
                    <input asp-for="Storage" class="form-control" />
                    <span asp-validation-for="Storage" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Quantity" class="control-label"></label>
                    <input asp-for="Quantity" class="form-control" />
                    <span asp-validation-for="Quantity" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="minQuantity" class="control-label"></label>
                    <input asp-for="minQuantity" class="form-control" />
                    <span asp-validation-for="minQuantity" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="priceForHome" class="control-label"></label>
                    <input asp-for="priceForHome" class="form-control" />
                    <span asp-validation-for="priceForHome" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="priceForPs" class="control-label"></label>
                    <input asp-for="priceForPs" class="form-control" />
                    <span asp-validation-for="priceForPs" class="text-danger"></span>
                </div><div class="form-group">
                    <label asp-for="priceForbuy" class="control-label"></label>
                    <input asp-for="priceForbuy" class="form-control" />
                    <span asp-validation-for="priceForbuy" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>

        </section>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
