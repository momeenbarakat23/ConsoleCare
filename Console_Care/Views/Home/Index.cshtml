@section Scripts {
    <script src="~/Swiper/swiper-bundle.min.js"></script>
    <script>
        var swiper = new Swiper(".mySwiper", {
        pagination: {
        el: ".swiper-pagination",
        dynamicBullets: true,
        clickable: true
        },
        autoplay: {
        delay: 2500,
        },
        loop: true,
        });    
    </script>
    @if (TempData["mes"] is not null)
    {
       <script>
            window.close(myalert())
       </script> 
}
}