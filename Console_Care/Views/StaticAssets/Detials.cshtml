@model IEnumerable<Console_Care.Models.StaticAssets>

@{
    ViewData["Title"] = "Detials";
}

@{

    var list2 = new HashSet<DateTime>();
    foreach (var item in Model)
    {
        list2.Add(item.DateTime);

    }
}
@section css {
    <link href="~/css/admin.css" rel="stylesheet" />
}

<partial>
    @Html.Partial("BankingDashBoard");
</partial>

<div class="mainorder">
    <div class="topbar">
        <div class="search">
            <label class="bar">
                <input type="text" id="searchinput" placeholder="Search Here..." onkeyup="search()" />
                <ion-icon name="search-outline"></ion-icon>
            </label>
        </div>
    </div>
    <div class="filter">
        <div class="filterlist">
            <label>date</label>
            <input type="date" class="form-control" id="filterdate" onchange="filter1()" />
        </div>
    </div>
    <div class="allorders uppertabemp">
        <div>
            <h2>الأصول الثابتة</h2>
        </div>
        <div>
            <a id="dl-csvorder" class="btn btn-secondary ">Download As Excel</a>
        </div>
        <div>
            <a asp-action="Add" class="btn btn-success ">Add</a>
        </div>
    </div>
    <section class="details">
        <div class="allorders">
            <div class="cardheader">
                <table class="table scroll" id="tblorder">
                    <thead>
                        <tr>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.Statement)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.Number)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.Price)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.Total)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.DateTime)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.typeOfStaticAssets)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.Specifications)</th>
                            <th class="tblcoltext ">@Html.DisplayNameFor(model => model.Note)</th>
                            <th class="tblcoltext"> </th>
                        </tr>
                    </thead>
                    <tbody class="mytable">
                        @foreach (var item in Model)
                        {
                            <tr class="order namesearch">
                                <td>@item.Statement </td>
                                <td>@item.Number</td>
                                <td>@item.Price</td>
                                <td>@item.Total</td>
                                <td>@item.DateTime.ToString("yyyy-MM-dd hh:mm:ss tt")</td>
                                <td>@item.typeOfStaticAssets</td>
                                <td>@item.Specifications</td>
                                <td>@item.Note</td>
                                <td>
                                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-secondary">Edit</a>|
                                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-danger">Delete</a>


                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </section>
</div>
