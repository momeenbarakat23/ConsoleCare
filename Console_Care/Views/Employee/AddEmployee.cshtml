@model Console_Care.Models.Employee

@{
    ViewData["Title"] = "AddEmployee";

}

@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>اضافه موظفين</h1>
<div class="mycontainer" style="margin-left:0px;">

    <div class=" Deleteform " style="width:100%">

        <section class="">
            <h2 class="title" style="color:white;">اضافه موظفين</h2>
            <form asp-action="AddEmployee" style="justify-items: center;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="name" class="control-label"></label>
                    <input asp-for="name" class="form-control" />
                    <span asp-validation-for="name" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="role" class="control-label"></label>
                    <input asp-for="role" class="form-control" />
                    <span asp-validation-for="role" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Note" class="control-label"></label>
                    <input asp-for="Note" class="form-control" />
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>

        </section>
    </div>
</div>