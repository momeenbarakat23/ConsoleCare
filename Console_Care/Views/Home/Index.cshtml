@{
    ViewData["Title"] = "Home Page";
}
@section css {
    <link rel="stylesheet" href="~/Swiper/swiper-bundle.min.css" />



}

<section class="main">
    <div class="mytext">
        <h2>ترحب بكم </h2>
        <span>Console Care</span>
        <p>we repair we care</p>
        <h3>
            نقدم خدمات صيانة شاملة وسريعة لأجهزة الألعاب الإلكترونية، مع ضمان أعلى مستويات الجودة والراحة. فريقنا المدرب والمحترف يستخدم أحدث التقنيات لتلبية احتياجات عشاق الألعاب، بهدف تعزيز تجربة اللعب وجعلها مستمرة دون انقطاع، وبناء علاقة ثقة طويلة الأمد مع عملائنا.
        </h3>
        <a asp-controller="Order" asp-action="Create" class="main-btn">Order Now</a>
    </div>
    <div class="slide-swp mySwiper">
        <div class="swiper-wrapper">
            <div class="swiper-slide">
                <a  ><img src="~/Img/slider1.jpg" alt="Alternate Text" /></a>
            </div>
            <div class="swiper-slide">
                <a href="#"><img src="~/Img/3.jpg" alt="Alternate Text" /></a>
            </div>
            <div class="swiper-slide">
                <a href="#"><img src="~/Img/4.jpg" alt="Alternate Text" /></a>
            </div>
            <div class="swiper-slide">
                <a href="#"><img src="~/Img/5.jpg" alt="Alternate Text" /></a>
            </div>


        </div>
        <div class="swiper-pagination"></div>
    </div>
    </div>
</section> 
<section class="cards" id="services">
    <h2 class="title">Services</h2>
    <div class="mycontent">
        <div class="mycard">
            <div class="icon">
                <img src="~/img/seana.jpg" alt="Alternate Text" />
            </div>
            <div class="info">
                <h3> صيانة </h3>
                <p>
                    مع كونسول كير ضمان بعد الصيانة مش مجرد كلام.
                    أي مشكلة تانية ممكن تظهر بعد الصيانة؟
                    مش هنسيبك لوحدك، ضماننا يشمل كل أنواع الصيانة وقطع الغيار كمان

                    وبنكلمك نتأكد من ان مفيش أي مشاكل معاك طول الوقت.
                </p>
            </div>
        </div>
        <div class="mycard">
            <div class="icon">
                <img src="~/img/twsel.jpg" alt="Alternate Text" />
            </div>
            <div class="info">
                <h3> الاحتلال</h3>
                <p>
                    كونسول كير مبقتش في القاهرة بس كونسول كير بقت في كل مصر دلوقتي 
                    لو أنت خارج القاهرة أو الجيزة
                    وفرنا عليك أسهل وأأمن طريقة لشحن دراعك من باب بيتك
                    بدون مشاوير وبدون تعب وفي الآخر هيوصلك دراعك بعد صيانته لحد بيتك من تاني
                    مع كونسول كير متشلش هم الصيانة تاني..
                </p>
            </div>
        </div>
        <div class="mycard">
            <div class="icon">
                <img src="~/img/hall.jpg" alt="Alternate Text" />
            </div>
            <div class="info">
                <h3> Hall Effect</h3>
                <p>
                    ال Aim بايظ منك، طب وانت بتعمل التشكيلة الانالوج بيجري منك علي الفرقة كلها؟ مشاكل الانالوج مبتخلصش
                    وكونسول كير جابتلك الحل النهائي لمشكلة ال Stick Drift
                    ال Hall Effect analog هيحللك كل مشاكلك وينقل متعة اللعب للفل تاني.
                    كلمنا أو ابعتلنا رسالة عشان تعرف اكتر عن ال Hall Effect..
                </p>
            </div>
        </div>
        <div class="mycard">
            <div class="icon">
                <img src="~/img/nng7.jpg" alt="Alternate Text" />
            </div>
            <div class="info">
                <h3> شركائك في نجاحك</h3>
                <p>
                    نجاحك من نجاحنا وسمعة مكانك من أولويتنا، عشان كده كونسول كير بتوفرلك كل خدمات الصيانة لمكانك بأفضل الأسعار،
                    وبضمان على جميع خدمات الصيانة وفي أسرع وقت بنكون عندك وبتم عملية الصيانة في 30 دقيقة.
                    عشان تفضل أفضل بلايستيشن كافية وتفضل أحلى مكان للمة الجايمرز.
                    اتصل بينا أو ابعتلنا رسالة وخليك مع خصومات كونسول كير لمحلات وأماكن البلايستيشن كافيه 
                </p>
            </div>
        </div>
        <div class="mycard">
            <div class="icon">
                <img src="~/img/sha7n.jpg" alt="Alternate Text" />
            </div>
            <div class="info">
                <h3> بطاريه</h3>
                <p>
                    عندك مشكله عدم شحن في الدراع؟ 
                    <br />                   مش مشكلة حلها بسيط كلمنا عشان نقدر نعرف منك عن نوع المشكله ونجيلك في اسرع وقت لحلها ,, او ابعتلنا رسالة عشان تعرف اكتر عن الصيانه و الحجز 
                </p>
            </div>
        </div>
        <div class="mycard">
            <div class="icon">
                <img src="~/img/elsa7.jpg" alt="Alternate Text" />
            </div>
            <div class="info">
                <h3> الصح أيه؟</h3>
                <p>
                    اكتر من 70% من اللعيبة بتستخدم اجهزة ال ps5 واقفة و ده على المدي الطويل بيسبب ضرر للمعالج عشان بيخلى ال thermal paste ميشتغلش باعلى كفاءة
                    عشان كده ال thermal paste اول حاجة بتتغير فى الصيانة الدورية الي بنقدمها في كونسول كير 
                </p>
            </div>
        </div>
        <div class="mycard">
            <div class="icon">
                <img src="~/img/cons.jpg" alt="Alternate Text" />
            </div>
            <div class="info">
                <h3> Console Care</h3>
                <p>
                    من و احنا اطفال و احنا جيمرز 👶🎮

                    عشان كده لما بقينا متخصصين فى الصيانة احنا حسينا بيك و بكل مشاكل الاجهزة من تهنيج او بطء او الدراعات كان كل ده عدى علينا قبل كده و عارفين ازاى نحله

                    عن طريق فريقنا المتخصص المدرب علي اعلي مستوي عشان يحللك كل مشاكلك في البيت وفي اسرع وقت ممكن

                    ابعتلنا رسالة او كلمنا فى اي وقت عشان تعرف تفاصيل اكتر للحجز
                </p>
            </div>
        </div>
        <div class="mycard">
            <div class="icon">
                <img src="~/img/motab3a.jpg" alt="Alternate Text" />
            </div>
            <div class="info">
                <h3> بنفكرك ديما</h3>
                <p>
                    -هنفكرك بمواعيد الصيانة الدورية و تنضيف الاجهزة عشان تفضل بكفاتها على طول
                </p>
            </div>
        </div>

    </div>

</section>

