@using Console_Care.ViewModel
@model MaterialsEmployeesviewmodel

@{
    ViewData["Title"] = "EditmaterialsEmployee";
}

@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>getdata</h1>
<div class="mycontainer">


    <div>
        <h1>Customer</h1>
        <hr />
        <div class="admintext">
            <dl class="row">
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.EmployeesName)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.EmployeesName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.materialName)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.materialName)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Quantities)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Quantities)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.QuantityUsed)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.QuantityUsed)
                </dd>
                <dt class="col-sm-2">
                    @Html.DisplayNameFor(model => model.Date)
                </dt>
                <dd class="col-sm-10">
                    @Html.DisplayFor(model => model.Date)
                </dd>
            </dl>
        </div>
    </div>
    <div class=" backgroundfrom">
        <div class="col-md-4">
                <form asp-action="EditmaterialsEmployee">
                    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                    <input type="hidden" asp-for="id" />
                    <input type="hidden" asp-for="Employeesid" />
                    <input type="hidden" asp-for="materialsId" />
                    <div class="form-group">
                        <label asp-for="Quantities" class="control-label"></label>
                    <input asp-for="Quantities" class="form-control" />
                    <span asp-validation-for="Quantities" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <input type="submit" value="Save" class="btn btn-primary" />
                    </div>
                </form>
           
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
