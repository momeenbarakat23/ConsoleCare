@using Console_Care.ViewModel
@model MaterialsEmployeesviewmodel

@{
    ViewData["Title"] = "AddmaterialsEmployee";

    SelectList nameofemp = new SelectList(ViewBag.NameOfEmployee, "name", "name");
    SelectList nameofmat = new SelectList(ViewBag.NameOfMaterial, "Name", "Name");
}

@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>AddEmployee</h1>
<div class="mycontainer" style="margin-left:0px;">

    <div class=" Deleteform " style="width:100%">

        <section class="">
            <h2 class="title" style="color:white;">AddEmployee</h2>
            <form asp-action="AddmaterialsEmployee" method="post" style="justify-items: center;">
                <div asp-validation-summary="All" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="EmployeesName" class="control-label"></label>
                    <select asp-items="nameofemp" asp-for="EmployeesName" class="form-control">
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="materialName" class="control-label"></label>
                    <select asp-items="nameofmat" asp-for="materialName" class="form-control">
                    </select>
                </div>
                <div class="form-group">
                    <label asp-for="Quantities" class="control-label"></label>
                    <input asp-for="Quantities" class="form-control" />
                    <span asp-validation-for="Quantities" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Date" class="control-label"></label>
                    <input asp-for="Date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>

        </section>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
