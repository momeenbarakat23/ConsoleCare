<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Console_Care</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Console_Care.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.1/css/all.min.css" integrity="sha512-5Hs3dF2AEPkpNAR7UiOHba+lRSJNeM2ECkwxUIxC1Q/FLycGTbNapWXB4tP889k5T5Ju8fs4b1P5z/iB4nMfSQ==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <link href="~/css/Style.css" rel="stylesheet" asp-append-version="true" />

    @await RenderSectionAsync("css", false)
</head>
<body>
    <header>
        <a asp-action="Index" asp-controller="Home" class="logo"><img src="~/img/logo.jpg" alt="Alternate Text" /></a>
        <nav class="navigation">
            <a asp-action="Index" asp-controller="Home" asp-fragment="services">services</a>
            <a asp-action="Index" asp-controller="Home" asp-fragment="reviews">Reviews</a>
            <a asp-action="Index" asp-controller="Home" asp-fragment="contact">Contact Us</a>
        </nav>
        <nav class="nav-btn">
            @if (User.Identity.IsAuthenticated)
            {
                <a asp-controller="Authanticat" asp-action="Signout">
                    <button class="mybtn" asp-fragment="signoutbtn" style="color:white;" >Sign Out</button>
                </a>
                

            }
            else
            {

                <a asp-controller="Authanticat" asp-action="LogIn"><button class="mybtn" style="color:white;" asp-fragment="loginbtn">Login</button></a>
                <a asp-controller="Authanticat" asp-action="Register"><button class="mybtn" style="color:white;" asp-fragment="Registerbtn">Register</button></a>
            }
            @if ((User.IsInRole("superadmin")))
            {
                <a asp-action="Index" asp-controller="Order" asp-fragment="contact" class="btn btn-success">Admin Dashboard</a>
            }@if ((User.IsInRole("technical")) || (User.IsInRole("assisstince")))
            {
                <a asp-action="GetData" asp-controller="itinerary" asp-fragment="contact" class="btn btn-success">Admin Dashboard</a>
            }

           
            @if (User.IsInRole("accounting") || User.IsInRole("superadmin"))
            {
                <a asp-action="Index" asp-controller="Banking" asp-fragment="contact" class="btn btn-danger">banking Dashboard</a>
            }
           

            
        </nav>
    </header>
    <div>
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="myfooter">
        <p class="footertitle">Copyrights // <span>Console Care</span></p>
    </footer>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script type="module" src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.esm.js"></script>
    <script nomodule src="https://unpkg.com/ionicons@7.1.0/dist/ionicons/ionicons.js"></script>
    <script src="~/js/table2excel.js"></script>
    <script src="~/sweetalert2/sweetalert2.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
