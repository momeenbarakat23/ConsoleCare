    ViewData["Title"] = "getdata";
    var dropdownlist = new SelectList(ViewBag.nameofemp);
}

@section css{
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>getdata</h1>
<div class="mycontainer">


