@model Console_Care.Models.Other_expenses

@{
    ViewData["Title"] = "Edit";
}


@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>AddCash</h1>
<div class="mycontainer" style="margin-left:0px;">
    <div class=" Deleteform " style="width:100%">

        <section class="">
            <h2 class="title" style="color:white;">تعديل مصروفات اخري</h2>
            <form asp-action="Edit" style="justify-items: center;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <input type="hidden" asp-for="Id" />

                <div class="form-group">
                    <label asp-for="DisbursementName" class="control-label"></label>
                    <input asp-for="DisbursementName" class="form-control" />
                    <span asp-validation-for="DisbursementName" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="typeofcash" class="control-label"></label>
                    <select class="form-control" asp-for="typeofcash" id="typeofcust">
                        <option>@Model.typeofcash</option>
                        <option value="VodafoneCash">VodafoneCash</option>
                        <option value="عهده">عهده</option>
                        <option value="Instapay">Instapay</option>
                        <option value="الخزنه">الخزنه</option>
                    </select>
                    <span asp-validation-for="typeofcash" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="ExpenseValue" class="control-label"></label>
                    <input asp-for="ExpenseValue" class="form-control" />
                    <span asp-validation-for="ExpenseValue" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="DateTime" class="control-label"></label>
                    <input asp-for="DateTime" class="form-control" />
                    <span asp-validation-for="DateTime" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Note" class="control-label"></label>
                    <input asp-for="Note" class="form-control" />
                    <span asp-validation-for="Note" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Save" class="btn btn-primary" />
                </div>
            </form>
        </section>
    </div>
</div>