            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.TypeOfCustomer)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.TypeOfCustomer)
            </dd>
            <dt class = "col-sm-2">
                @Html.DisplayNameFor(model => model.Ps4OrPs5)
            </dt>
            <dd class = "col-sm-10">
                @Html.DisplayFor(model => model.Ps4OrPs5)
