@model Console_Care.Models.Closeday

@{
    ViewData["Title"] = "Edit";
}

@section css {
    <link href="~/css/adminform.css" rel="stylesheet" />
}
<h1>AddCash</h1>
<div class="mycontainer" style="margin-left:0px;">
    <div class=" Deleteform " style="width:100%">

        <section class="">
            <h2 class="title" style="color:white;">تقفيل اليوم</h2>
            <form asp-action="Edit" style="justify-items: center;">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="Date" class="control-label"></label>
                    <input asp-for="Date" class="form-control" />
                    <span asp-validation-for="Date" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Origins" class="control-label"></label>
                    <input asp-for="Origins" class="form-control" />
                    <span asp-validation-for="Origins" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Cash" class="control-label"></label>
                    <input asp-for="Cash" class="form-control" />
                    <span asp-validation-for="Cash" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Sales" class="control-label"></label>
                    <input asp-for="Sales" class="form-control" />
                    <span asp-validation-for="Sales" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PaidSales" class="control-label"></label>
                    <input asp-for="PaidSales" class="form-control" />
                    <span asp-validation-for="PaidSales" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Remainingsales" class="control-label"></label>
                    <input asp-for="Remainingsales" class="form-control" />
                    <span asp-validation-for="Remainingsales" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Procurement" class="control-label"></label>
                    <input asp-for="Procurement" class="form-control" />
                    <span asp-validation-for="Procurement" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="PaidPurchases" class="control-label"></label>
                    <input asp-for="PaidPurchases" class="form-control" />
                    <span asp-validation-for="PaidPurchases" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Remainingpurchases" class="control-label"></label>
                    <input asp-for="Remainingpurchases" class="form-control" />
                    <span asp-validation-for="Remainingpurchases" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="Expenses" class="control-label"></label>
                    <input asp-for="Expenses" class="form-control" />
                    <span asp-validation-for="Expenses" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create" class="btn btn-primary" />
                </div>
            </form>
        </section>
    </div>
</div>