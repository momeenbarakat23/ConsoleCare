    </div>
    <div class=" backgroundfrom">
        <div class="col-md-4">
            <form asp-action="AddData">
                <div asp-validation-summary="ModelOnly" class="text-danger"></div>
                <div class="form-group">
                    <label asp-for="VisitClassification" class="control-label"></label>
                    <input asp-for="VisitClassification" class="form-control" />
                    <span asp-validation-for="VisitClassification" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="VisitDate" class="control-label"></label>
                    <input asp-for="VisitDate" class="form-control" />
                    <span asp-validation-for="VisitDate" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NameOfTechnician" class="control-label"></label>
                    <select asp-items="dropdownlist" asp-for="NameOfTechnician" class="form-control" id="nameoftech">
                        <option value="0" selected>select</option>
                    </select>
                    <span asp-validation-for="NameOfTechnician" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="NameOfAssistant" class="control-label"></label>
                    <select asp-items="dropdownlist" asp-for="NameOfAssistant" class="form-control" id="nameoftech">
                        <option value="0" selected>select</option>
                    </select>
                    <span asp-validation-for="NameOfAssistant" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RemainingTeam" class="control-label"></label>
                    <input asp-for="RemainingTeam" class="form-control" />
                    <span asp-validation-for="RemainingTeam" class="text-danger"></span>
                </div>
         
                <div class="form-group">
                    <label asp-for="NotesToMaintenanceTeam" class="control-label"></label>
                    <input asp-for="NotesToMaintenanceTeam" class="form-control" />
                    <span asp-validation-for="NotesToMaintenanceTeam" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="RouteDistributionOfficer" class="control-label"></label>
                    <input asp-for="RouteDistributionOfficer" class="form-control" />
                    <span asp-validation-for="RouteDistributionOfficer" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <label asp-for="VisitStatus" class="control-label"></label>
                    <input asp-for="VisitStatus" class="form-control" />
                    <span asp-validation-for="VisitStatus" class="text-danger"></span>
                </div>
                <div class="form-group">
                    <input type="submit" value="Create"  class="btn btn-primary" />
                </div>
            </form>
        </div>
